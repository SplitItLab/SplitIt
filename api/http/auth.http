client.test("rejects an unknown private endpoint without a session", function () {
    assertError(client, response, 401, "Unauthorized")
})
%}

### Logout — success (204)
POST {{baseUrl}}/api/auth/logout
Accept: application/json
Cookie: auth_token={{authToken}}

> {%
import { assertNoContent, assertSessionCookieCleared } from './scripts/assert.js'

client.test("expires the session cookie without a body", function () {
    assertNoContent(client, response)
    assertSessionCookieCleared(client, response, "auth_token")
})
%}

