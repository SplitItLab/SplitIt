### 19. Me — Token de invitado por Bearer (403)
# @no-cookie-jar
GET {{baseUrl}}/api/me
Accept: application/json
Authorization: Bearer {{guestToken}}

> {%
import { assertError } from './scripts/assert.js'

client.test("el token de invitado por Bearer no es un usuario", function () {
    assertError(client, response, 403, "Forbidden")
})
%}

### 20. Session — Token de invitado en la cookie de sesión (401)
# @no-cookie-jar
GET {{baseUrl}}/api/auth/session
Accept: application/json
Cookie: auth_token={{guestToken}}

> {%
import { assertError } from './scripts/assert.js'

client.test("el token de invitado no sirve como sesión de usuario", function () {
    assertError(client, response, 401, "Unauthorized")
})
%}

### 21. Session — Token de usuario en la cookie de invitado (401)
# @no-cookie-jar
GET {{baseUrl}}/api/auth/session
Accept: application/json
Cookie: guest_token={{authToken}}

> {%
import { assertError } from './scripts/assert.js'

client.test("el token de usuario no sirve como credencial de invitado", function () {
    assertError(client, response, 401, "Unauthorized")
})
%}

### 22. Session — Sesión de usuario y credencial de invitado (gana la sesión)
# @no-cookie-jar
GET {{baseUrl}}/api/auth/session
Accept: application/json
Cookie: auth_token={{authToken}}; guest_token={{guestToken}}

> {%
import { assertSessionUser } from './scripts/assert.js'

client.test("responde como el usuario", function () {
    assertSessionUser(client, response, {
        name: "Owner Guest Flow",
        emailPattern: /^guest\.owner-\d+@example\.com$/,
    })
})
%}

### 23. Logout — Borra la sesión y la credencial de invitado (204)
# @no-cookie-jar
POST {{baseUrl}}/api/auth/logout
Accept: application/json
Cookie: auth_token={{authToken}}; guest_token={{guestToken}}

> {%
import { assertNoContent, assertSessionCookieCleared } from './scripts/assert.js'

client.test("expira las dos cookies", function () {
    assertNoContent(client, response)
    assertSessionCookieCleared(client, response, "auth_token")
    assertSessionCookieCleared(client, response, "guest_token")
})
%}
