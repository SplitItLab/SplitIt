PATCH {{baseUrl}}/api/me
Content-Type: application/json
Accept: application/json
Cookie: auth_token={{authToken}}

{
  "name": "Ada Byron Lovelace",
  "email": "not-an-email"
}

> {%
import { assertError } from './scripts/assert.js'

client.test("rejects an invalid email", function () {
    assertError(client, response, 400, "Invalid request data")
})
%}

### Me — PATCH email already in use (409)
PATCH {{baseUrl}}/api/me
Content-Type: application/json
Accept: application/json
Cookie: auth_token={{authToken}}

{
  "name": "Ada Byron Lovelace",
  "email": "{{takenEmail}}"
}

> {%
import { assertError } from './scripts/assert.js'

client.test("rejects an email owned by another account", function () {
    assertError(client, response, 409, "Email already in use")
})
%}

### Me — PATCH email (200)
PATCH {{baseUrl}}/api/me
Content-Type: application/json
Accept: application/json
Cookie: auth_token={{authToken}}

{
  "name": "Ada Byron Lovelace",
  "email": "{{updatedEmail}}"
}

> {%
import { assertSessionUser, assertSetCookieHttpOnly, saveAuthToken } from './scripts/assert.js'

client.test("updates the email and returns the persisted account", function () {
    assertSessionUser(client, response, {
        name: "Ada Byron Lovelace",
        emailPattern: /^ada\.me\.updated-\d+@example\.com$/,
    })
    client.global.set("persistedEmail", response.body.email)
    assertSetCookieHttpOnly(client, response, "auth_token")
})
saveAuthToken(client, response, "auth_token")
%}

### Me — GET after update (200)
GET {{baseUrl}}/api/me
Accept: application/json
Cookie: auth_token={{authToken}}

> {%
import { assertSessionUser } from './scripts/assert.js'

client.test("returns the persisted name and email after the update", function () {
    assertSessionUser(client, response, {
        name: "Ada Byron Lovelace",
        email: client.global.get("persistedEmail"),
    })
})
%}

### Me — PATCH without cookie (401)
# @no-cookie-jar
PATCH {{baseUrl}}/api/me
Content-Type: application/json
Accept: application/json

{
  "name": "Ada Lovelace",
  "email": "ada@example.com"
}

> {%
import { assertError } from './scripts/assert.js'

client.test("rejects a profile update without a session", function () {
    assertError(client, response, 401, "Unauthorized")
})
%}

### Login — new email after profile update (200)
# @no-cookie-jar
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{persistedEmail}}",
  "password": "{{mePassword}}"
}

> {%
import { assertSessionUser, assertSetCookieHttpOnly } from './scripts/assert.js'

client.test("logs in with the updated email", function () {
    assertSessionUser(client, response, {
        name: "Ada Byron Lovelace",
        email: client.global.get("persistedEmail"),
    })
    assertSetCookieHttpOnly(client, response, "auth_token")
})
%}
