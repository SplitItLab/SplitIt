POSTGRES_USER=
POSTGRES_PASSWORD=

POSTGRES_DB=splitit
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# disable en Docker local. require en Neon / Vercel.
POSTGRES_SSLMODE=disable

# Local: URL absoluta de la API. En Vercel se deja vacío (mismo origen vía /api).
NEXT_PUBLIC_API_URL=http://localhost:8080
WEB_PORT=3000

# Al menos 32 caracteres (HMAC-SHA256)
JWT_SECRET=
JWT_EXPIRATION_HOURS=8

AUTH_COOKIE_NAME=auth_token
# HTTP local: false. El default de la API es true (producción).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# KPIs -> plataforma central (Supabase).
# KPI_EXPORT_MODE: local (default), report o supabase.
# KPI_EXPORT_ENV (dev, qa o prod) tiene que coincidir con el ambiente de la project key.
# Sin project key el envio se saltea con un log y el calculo sigue corriendo.
KPI_EXPORT_MODE=local
KPI_EXPORT_ENV=dev
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_KEY=
