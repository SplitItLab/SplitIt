# KPI runs — SplitIt API
#
# Cómo usar
#   IntelliJ: Run All en este archivo (env "local"). Los asserts salen en la pestaña Tests.
#   VS Code: REST Client; ejecutá cada bloque `###`.
#   La API tiene que estar en {{baseUrl}} (por defecto localhost:8080).
#
# En local y en dev, KPI_EXPORT_MODE queda en local: la corrida se guarda
# con destination "local". No escribe el canal report.
# En production de Vercel hay que setear KPI_EXPORT_MODE=report.
#
@baseUrl = http://localhost:8080
@kpiUserEmail = kpi.runner-{{$timestamp}}@example.com
@kpiUserPassword = una-clave-segura

### 1. Seed — Crear cuenta para disparar la corrida
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "KPI Runner",
  "email": "{{kpiUserEmail}}",
  "password": "{{kpiUserPassword}}"
}

> {%
import { assertStatus } from './scripts/assert.js'

client.test("crea usuario para la corrida de KPIs", function () {
    assertStatus(client, response, 201)
})
%}

### 2. Login — Iniciar sesión y capturar cookie
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{kpiUserEmail}}",
  "password": "{{kpiUserPassword}}"
}

> {%
import { assertStatus, assertSetCookieHttpOnly, saveAuthToken } from './scripts/assert.js'

client.test("inicia sesión", function () {
    assertStatus(client, response, 200)
    assertSetCookieHttpOnly(client, response, "auth_token")
})
saveAuthToken(client, response, "auth_token")
%}

### 3. KPI runs — POST sin día (ayer UTC)
POST {{baseUrl}}/api/kpi-runs
Accept: application/json
Cookie: auth_token={{authToken}}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("guarda la corrida de ayer en el destino local", function () {
    assertStatus(client, response, 201)
    const body = jsonBody(response)
    client.assert(body.destination === "local", "Expected destination local but got " + body.destination)
    client.assert(Array.isArray(body.results) && body.results.length === 7, "Expected the 7 KPIs")
    client.global.set("firstRunId", body.id)
    client.global.set("firstReportDay", body.reportDay)
})
%}

### 4. KPI runs — POST de otro día
POST {{baseUrl}}/api/kpi-runs
Content-Type: application/json
Accept: application/json
Cookie: auth_token={{authToken}}

{
  "reportDay": "2026-01-15"
}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("guarda un segundo día distinto", function () {
    assertStatus(client, response, 201)
    const body = jsonBody(response)
    client.assert(body.reportDay === "2026-01-15", "Expected reportDay 2026-01-15 but got " + body.reportDay)
    client.assert(body.reportDay !== client.global.get("firstReportDay"), "The two runs must be different days")
    client.assert(body.destination === "local", "Dev run stays on the local channel")
    client.global.set("secondRunId", body.id)
})
%}

### 5. KPI runs — GET consulta las corridas guardadas
GET {{baseUrl}}/api/kpi-runs
Accept: application/json
Cookie: auth_token={{authToken}}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("las dos corridas quedan consultables", function () {
    assertStatus(client, response, 200)
    const body = jsonBody(response)
    client.assert(Array.isArray(body), "Expected a list")
    const ids = body.map(function (run) { return run.id })
    client.assert(ids.indexOf(client.global.get("firstRunId")) >= 0, "Missing the first run")
    client.assert(ids.indexOf(client.global.get("secondRunId")) >= 0, "Missing the second run")
    const days = body.map(function (run) { return run.reportDay })
    const distinct = days.filter(function (day, index) { return days.indexOf(day) === index })
    client.assert(distinct.length >= 2, "Expected at least two distinct report days")
})
%}
