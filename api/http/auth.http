# Auth — SplitIt API
#
# Cómo usar
#   IntelliJ: Run All en este archivo (env "local"). Los asserts salen en la pestaña Tests.
#   VS Code: REST Client; ejecutá cada bloque `###`.
#   La API tiene que estar en {{baseUrl}} (por defecto localhost:8080).
#
# Convención de api/http/
#   Un archivo por recurso: auth.http, groups.http, expenses.http, ...
#   Asserts compartidos: scripts/assert.js
#   Host y ambientes: http-client.env.json
#   Tokens y secretos: http-client.private.env.json (gitignored)
#
# Correr de arriba a abajo: el 409 de duplicado asume que la seed ya corrió.
#
@baseUrl = http://localhost:8080
@newEmail = ada-{{$timestamp}}@example.com
@conflictEmail = ada.conflict@example.com
@loginEmail = ada.login@example.com
@loginPassword = una-clave-segura

### Register — success (201)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "Ada Lovelace",
  "email": "{{newEmail}}",
  "password": "una-clave-segura"
}

> {%
import { assertCreatedUser } from './scripts/assert.js'

client.test("creates a user with public fields only", function () {
    assertCreatedUser(client, response, {
        name: "Ada Lovelace",
        emailPattern: /^ada-\d+@example\.com$/,
    })
})
%}

### Register — missing name (400)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "ada@example.com",
  "password": "una-clave-segura"
}

> {%
import { assertError } from './scripts/assert.js'

client.test("rejects missing name", function () {
    assertError(client, response, 400, "Invalid request data")
})
%}

