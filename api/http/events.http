})
%}

### 12. Events — GET detalle de evento por dueño (200)
GET {{baseUrl}}/api/events/{{firstEventId}}
Accept: application/json
Cookie: auth_token={{authToken}}

> {%
import { assertStatus, jsonBody, assertEventDetail } from './scripts/assert.js'

client.test("obtiene el detalle del evento con sus integrantes", function () {
    assertStatus(client, response, 200)
    const body = jsonBody(response)
    assertEventDetail(client, body, {
        id: client.global.get("firstEventId"),
        name: "Viaje a Bariloche",
        description: "Vacaciones de verano",
        iconKey: "plane",
        baseCurrency: "ARS",
        memberCount: 3,
    })
    client.assert(body.members.length === 3, "Expected 3 members")
    const ownerMember = body.members.find(m => !m.isGuest)
    client.assert(ownerMember !== undefined, "Expected linked owner member")
    client.assert(typeof ownerMember.email === "string" && ownerMember.email.length > 0, "Expected owner email")
    const guests = body.members.filter(m => m.isGuest)
    client.assert(guests.length === 2, "Expected 2 guest members")
    guests.forEach(g => {
        client.assert(g.email === null || g.email === undefined, "Guest must not have email")
    })
})
%}

