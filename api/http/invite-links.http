Accept: application/json
Cookie: guest_token={{guestToken}}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("el invitado ve a quién le pagan", function () {
    assertStatus(client, response, 200)
    const toJuan = jsonBody(response).filter(p => String(p.toMember.id) === client.global.get("juanMemberId"))
    client.assert(toJuan.length > 0, "Expected payments to Juan")
})
%}

