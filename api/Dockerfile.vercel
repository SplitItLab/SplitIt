# syntax=docker/dockerfile:1
FROM gradle:9.7.1-jdk21 AS build
WORKDIR /app
ENV GRADLE_USER_HOME=/gradle-cache
COPY build.gradle.kts settings.gradle.kts gradlew ./
COPY gradle/ ./gradle/
RUN --mount=type=cache,target=/gradle-cache gradle --no-daemon dependencies --quiet > /dev/null || true
COPY src ./src
RUN --mount=type=cache,target=/gradle-cache gradle --no-daemon --build-cache bootJar

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/build/libs/*.jar app.jar
ENV PORT=8080
ENV JAVA_TOOL_OPTIONS="-XX:TieredStopAtLevel=1"
EXPOSE 8080

CMD ["/opt/java/openjdk/bin/java", \
  "-XX:MaxRAMPercentage=75.0", \
  "-XX:+ExitOnOutOfMemoryError", \
  "-jar", "app.jar"]