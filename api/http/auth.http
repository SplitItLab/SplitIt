### Login — after logout (200 + HttpOnly cookie)
# @no-cookie-jar
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{loginEmail}}",
  "password": "{{loginPassword}}"
}

> {%
import { assertSessionUser, assertSetCookieHttpOnly } from './scripts/assert.js'

client.test("logs in again with the same account after logout", function () {
    assertSessionUser(client, response, {
        name: "Ada Lovelace",
        email: "ada.login@example.com",
    })
    assertSetCookieHttpOnly(client, response, "auth_token")
})
%}
