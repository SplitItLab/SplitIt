### 10. Events — GET listar eventos del usuario (200)
GET {{baseUrl}}/api/events
Accept: application/json
Cookie: auth_token={{authToken}}

> {%
import { assertStatus, jsonBody, assertEvent } from './scripts/assert.js'

client.test("lista los eventos del usuario autenticado", function () {
    assertStatus(client, response, 200)
    const list = jsonBody(response)
    client.assert(Array.isArray(list), "Expected array of events")
    client.assert(list.length === 2, "Expected exactly 2 events for this user")
    const found = list.find(e => String(e.id) === client.global.get("firstEventId"))
    client.assert(found !== undefined, "Expected created event in list")
    assertEvent(client, found, {
        id: client.global.get("firstEventId"),
        name: "Viaje a Bariloche",
        description: "Vacaciones de verano",
        iconKey: "plane",
        baseCurrency: "ARS",
        memberCount: 3,
    })
})
%}

