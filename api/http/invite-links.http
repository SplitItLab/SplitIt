### 22. Session — Sesión de usuario y credencial de invitado (gana la sesión)
# @no-cookie-jar
GET {{baseUrl}}/api/auth/session
Accept: application/json
Cookie: auth_token={{authToken}}; guest_token={{guestToken}}

> {%
import { assertSessionUser } from './scripts/assert.js'

client.test("responde como el usuario", function () {
    assertSessionUser(client, response, {
        name: "Owner Guest Flow",
        emailPattern: /^guest\.owner-\d+@example\.com$/,
    })
})
%}

### 23. Logout — Borra la sesión y la credencial de invitado (204)
# @no-cookie-jar
POST {{baseUrl}}/api/auth/logout
Accept: application/json
Cookie: auth_token={{authToken}}; guest_token={{guestToken}}

> {%
import { assertNoContent, assertSessionCookieCleared } from './scripts/assert.js'

client.test("expira las dos cookies", function () {
    assertNoContent(client, response)
    assertSessionCookieCleared(client, response, "auth_token")
    assertSessionCookieCleared(client, response, "guest_token")
})
%}

### 24. Events — Invitado ve su evento y sabe qué integrante es (200)
# @no-cookie-jar
GET {{baseUrl}}/api/events/{{guestEventId}}
Accept: application/json
Cookie: guest_token={{guestToken}}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("el invitado ve el evento como Juan, sin ser dueño", function () {
    assertStatus(client, response, 200)
    const event = jsonBody(response)
    client.assert(String(event.id) === client.global.get("guestEventId"), "Expected the guest event")
    client.assert(event.isOwner === false, "A guest is never the owner")
    client.assert(String(event.guestMemberId) === client.global.get("juanMemberId"), "Expected Juan as the guest member")
})
%}

### 25. Events — El dueño no figura como invitado (200)
# @no-cookie-jar
GET {{baseUrl}}/api/events/{{guestEventId}}
Accept: application/json
Cookie: auth_token={{authToken}}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("para el dueño no hay integrante de invitado", function () {
    assertStatus(client, response, 200)
    client.assert(jsonBody(response).isOwner === true, "Expected the owner")
    client.assert(jsonBody(response).guestMemberId === null, "A user has no guest member")
})
%}

### 26. Expenses — Invitado carga un gasto pagado por su integrante (201)
# @no-cookie-jar
POST {{baseUrl}}/api/events/{{guestEventId}}/expenses
Content-Type: application/json
Accept: application/json
Cookie: guest_token={{guestToken}}

{
  "name": "Helado",
  "amount": 3000,
  "currency": "ARS",
  "paidByMemberId": {{juanMemberId}}
}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("el invitado carga lo que pagó Juan", function () {
    assertStatus(client, response, 201)
    client.assert(String(jsonBody(response).paidByMember.id) === client.global.get("juanMemberId"), "Expected Juan as payer")
    client.global.set("guestExpenseId", String(jsonBody(response).id))
})
%}

