# Events — SplitIt API
#
# Cómo usar
#   IntelliJ: Run All en este archivo (env "local"). Los asserts salen en la pestaña Tests.
#   VS Code: REST Client; ejecutá cada bloque `###`.
#   La API tiene que estar en {{baseUrl}} (por defecto localhost:8080).
#
@baseUrl = http://localhost:8080
@eventOwnerEmail = event.owner-{{$timestamp}}@example.com
@eventOwnerPassword = una-clave-segura
@otherUserEmail = other.user-{{$timestamp}}@example.com
@otherUserPassword = una-clave-segura

### 1. Seed — Crear cuenta de prueba para el dueño
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "Owner User",
  "email": "{{eventOwnerEmail}}",
  "password": "{{eventOwnerPassword}}"
}

> {%
import { assertStatus } from './scripts/assert.js'

client.test("crea usuario para pruebas de eventos", function () {
    assertStatus(client, response, 201)
})
%}

### 2. Login — Iniciar sesión y capturar cookie de autenticación
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{eventOwnerEmail}}",
  "password": "{{eventOwnerPassword}}"
}

> {%
import { assertStatus, assertSetCookieHttpOnly, saveAuthToken } from './scripts/assert.js'

client.test("inicia sesión exitosamente", function () {
    assertStatus(client, response, 200)
    assertSetCookieHttpOnly(client, response, "auth_token")
})
saveAuthToken(client, response, "auth_token")
%}

### 3. Events — POST crear evento completo con participantes (201)
POST {{baseUrl}}/api/events
Content-Type: application/json
Accept: application/json
Cookie: auth_token={{authToken}}

{
  "name": "Viaje a Bariloche",
  "description": "Vacaciones de verano",
  "iconKey": "plane",
  "baseCurrency": "ARS",
  "participantNames": ["Ana", "Juan"]
}

> {%
import { assertStatus, jsonBody, assertEvent } from './scripts/assert.js'

client.test("crea un evento con participantes adicionales y devuelve memberCount = 3", function () {
    assertStatus(client, response, 201)
    const body = jsonBody(response)
    assertEvent(client, body, {
        name: "Viaje a Bariloche",
        description: "Vacaciones de verano",
        iconKey: "plane",
        baseCurrency: "ARS",
        memberCount: 3,
    })
    client.global.set("firstEventId", String(body.id))
})
%}

