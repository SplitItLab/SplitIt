# Invite links — SplitIt API
#
# Cómo usar
#   IntelliJ: Run All en este archivo (env "local"). Los asserts salen en la pestaña Tests.
#   VS Code: REST Client; ejecutá cada bloque `###`.
#   La API tiene que estar en {{baseUrl}} (por defecto localhost:8080).
#
# Todos los pedidos van sin cookie jar: cada uno manda a mano la cookie que prueba,
# así la sesión del dueño no tapa la credencial de invitado.
#
@baseUrl = http://localhost:8080
@ownerEmail = guest.owner-{{$timestamp}}@example.com
@ownerPassword = una-clave-segura
@juanEmail = guest.juan-{{$timestamp}}@example.com

### 1. Seed — Crear cuenta del dueño
# @no-cookie-jar
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "Owner Guest Flow",
  "email": "{{ownerEmail}}",
  "password": "{{ownerPassword}}"
}

> {%
import { assertStatus } from './scripts/assert.js'

client.test("crea el dueño del evento", function () {
    assertStatus(client, response, 201)
})
%}

### 2. Login — Dueño
# @no-cookie-jar
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{ownerEmail}}",
  "password": "{{ownerPassword}}"
}

> {%
import { assertStatus, saveAuthToken } from './scripts/assert.js'

client.test("inicia sesión como dueño", function () {
    assertStatus(client, response, 200)
})
saveAuthToken(client, response, "auth_token")
%}

### 3. Seed — Evento con integrantes sin cuenta
# @no-cookie-jar
POST {{baseUrl}}/api/events
Content-Type: application/json
Accept: application/json
Cookie: auth_token={{authToken}}

{
  "name": "Asado del sábado",
  "baseCurrency": "ARS",
  "participantNames": ["Juan", "Pedro"]
}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("crea el evento al que entra el invitado", function () {
    assertStatus(client, response, 201)
    client.global.set("guestEventId", String(jsonBody(response).id))
})
%}

### 4. Seed — Otro evento del dueño
# @no-cookie-jar
POST {{baseUrl}}/api/events
Content-Type: application/json
Accept: application/json
Cookie: auth_token={{authToken}}

{
  "name": "Viaje a Mendoza",
  "baseCurrency": "ARS",
  "participantNames": ["Lucía"]
}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("crea un segundo evento", function () {
    assertStatus(client, response, 201)
    client.global.set("otherEventId", String(jsonBody(response).id))
})
%}

### 5. Seed — Enlace de acceso del evento
# @no-cookie-jar
POST {{baseUrl}}/api/events/{{guestEventId}}/invite-link
Accept: application/json
Cookie: auth_token={{authToken}}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("obtiene el token del enlace", function () {
    assertStatus(client, response, 200)
    client.global.set("guestInviteToken", jsonBody(response).token)
})
%}

### 6. Seed — Integrantes del evento
# @no-cookie-jar
GET {{baseUrl}}/api/events/{{guestEventId}}
Accept: application/json
Cookie: auth_token={{authToken}}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("captura un integrante sin cuenta y el dueño", function () {
    assertStatus(client, response, 200)
    const members = jsonBody(response).members
    const juan = members.find(m => m.name === "Juan")
    const owner = members.find(m => !m.isGuest)
    client.assert(juan !== undefined && juan.isGuest, "Expected Juan without an account")
    client.assert(owner !== undefined, "Expected the owner member")
    client.global.set("juanMemberId", String(juan.id))
    client.global.set("ownerMemberId", String(owner.id))
})
%}

### 7. Seed — Integrante del otro evento
# @no-cookie-jar
GET {{baseUrl}}/api/events/{{otherEventId}}
Accept: application/json
Cookie: auth_token={{authToken}}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("captura un integrante de otro evento", function () {
    assertStatus(client, response, 200)
    const lucia = jsonBody(response).members.find(m => m.name === "Lucía")
    client.assert(lucia !== undefined, "Expected Lucía")
    client.global.set("otherEventMemberId", String(lucia.id))
})
%}

### 8. Guest — Entrar como integrante sin cuenta (200 + cookie HttpOnly)
# @no-cookie-jar
POST {{baseUrl}}/api/invite-links/{{guestInviteToken}}/guest-session
Content-Type: application/json
Accept: application/json

{
  "memberId": {{juanMemberId}}
}

> {%
import { assertGuestSession, assertSetCookieHttpOnly, authTokenFromSetCookie, setCookieHeader } from './scripts/assert.js'

client.test("entra como Juan sin cuenta", function () {
    assertGuestSession(client, response, {
        eventId: client.global.get("guestEventId"),
        memberId: client.global.get("juanMemberId"),
        name: "Juan",
    })
    assertSetCookieHttpOnly(client, response, "guest_token")
    client.assert(/max-age=604800/i.test(setCookieHeader(response)), "Guest cookie must last 7 days")
})
client.global.set("guestToken", authTokenFromSetCookie(response, "guest_token"))
%}

