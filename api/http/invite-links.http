### 30. Balances — Invitado ve los saldos (200)
# @no-cookie-jar
GET {{baseUrl}}/api/events/{{guestEventId}}/balances
Accept: application/json
Cookie: guest_token={{guestToken}}

> {%
import { assertStatus, jsonBody } from './scripts/assert.js'

client.test("el invitado ve el saldo de Juan", function () {
    assertStatus(client, response, 200)
    const juan = jsonBody(response).find(b => String(b.memberId) === client.global.get("juanMemberId"))
    client.assert(juan !== undefined && juan.netBalance > 0, "Juan paid, so he is owed money")
})
%}

### 31. Suggested payments — Invitado ve los pagos sugeridos (200)
