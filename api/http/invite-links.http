})
%}

### 14. Session — Invitado (200)
# @no-cookie-jar
GET {{baseUrl}}/api/auth/session
Accept: application/json
Cookie: guest_token={{guestToken}}

> {%
import { assertGuestSession } from './scripts/assert.js'

client.test("la sesión dice quién es el invitado y de qué evento", function () {
    assertGuestSession(client, response, {
        eventId: client.global.get("guestEventId"),
        memberId: client.global.get("juanMemberId"),
        name: "Juan",
    })
})
%}

