GET {{baseUrl}}/api/auth/session
Accept: application/json
Cookie: auth_token=tampered.token.value

> {%
import { assertError } from './scripts/assert.js'

client.test("rejects a manipulated session without an internal error", function () {
    assertError(client, response, 401, "Unauthorized")
})
%}

