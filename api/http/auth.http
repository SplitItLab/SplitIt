### Register — seed for duplicate email (201 first time, 409 after)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "Ada Lovelace",
  "email": "Ada.Conflict@example.com",
  "password": "una-clave-segura"
}

> {%
import { assertCreatedUser, assertError } from './scripts/assert.js'

client.test("seeds conflict email or reports it already exists", function () {
    if (response.status === 201) {
        assertCreatedUser(client, response, {
            name: "Ada Lovelace",
            email: "ada.conflict@example.com",
        })
        return
    }
    assertError(client, response, 409, "Email already in use")
})
%}

### Register — duplicate normalized email (409)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "Ada Lovelace",
  "email": "{{conflictEmail}}",
  "password": "una-clave-segura"
}

> {%
import { assertError } from './scripts/assert.js'

client.test("rejects duplicate normalized email", function () {
    assertError(client, response, 409, "Email already in use")
})
%}

### Register — seed for login (201 first time, 409 after)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "Ada Lovelace",
  "email": "{{loginEmail}}",
  "password": "{{loginPassword}}"
}

> {%
import { assertCreatedUser, assertError } from './scripts/assert.js'

client.test("seeds a user that can log in", function () {
    if (response.status === 201) {
        assertCreatedUser(client, response, {
            name: "Ada Lovelace",
            email: "ada.login@example.com",
        })
        return
    }
    assertError(client, response, 409, "Email already in use")
})
%}

### Login — success (200 + HttpOnly cookie)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{loginEmail}}",
  "password": "{{loginPassword}}"
}

> {%
import { assertSessionUser, assertSetCookieHttpOnly, saveAuthToken } from './scripts/assert.js'

client.test("creates a session with public fields only", function () {
    assertSessionUser(client, response, {
        name: "Ada Lovelace",
        email: "ada.login@example.com",
    })
    assertSetCookieHttpOnly(client, response, "auth_token")
})
saveAuthToken(client, response, "auth_token")
%}

