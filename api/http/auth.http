### Session — valid cookie from login (200)
GET {{baseUrl}}/api/auth/session
Accept: application/json
Cookie: auth_token={{authToken}}

> {%
import { assertSessionUser } from './scripts/assert.js'

client.test("restores the public user from the session cookie", function () {
    assertSessionUser(client, response, {
        name: "Ada Lovelace",
        email: "ada.login@example.com",
    })
})
%}

### Session — no cookie (401)
# @no-cookie-jar
GET {{baseUrl}}/api/auth/session
Accept: application/json

> {%
import { assertError } from './scripts/assert.js'

client.test("rejects a private route without a session", function () {
    assertError(client, response, 401, "Unauthorized")
})
%}

### Session — tampered cookie (401)
